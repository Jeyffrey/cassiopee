---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = 'Cassiopée Astro',
  description = 'Chœur Cassiopée, chorale de jeunes à Lyon. Découvrez nos concerts, notre répertoire et rejoignez-nous.',
  pageClass,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/cassiopee-icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chœur Cassiopée" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo du Chœur Cassiopée" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class={pageClass}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Quicksand:wght@300..700&display=swap');

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --c-beige: #f3ece4;
    --c-beige-light: #faf6f3;
    --c-orange: #aa603d;
    --c-vert: #56704d;
    --c-taupe: #ae8d6a;
    --c-bleu: #6d7f8e;
    --c-rouge: #b5354a;
  }

  html {
    font-family: 'Quicksand', sans-serif;
    font-optical-sizing: auto;
    font-weight: 500;
    font-style: normal;
    font-size: 1.125rem;
    background-color: var(--c-beige);
  }

  body {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
    margin: 0;
  }

  main {
    flex: 1;
    padding-top: 1rem;
  }

  .c-global-container {
    margin: auto;
    padding: 1rem;
    width: 100%;
    max-width: 1300px;
  }

  /* Global title */
  .c-global-title {
    font-family: 'Cormorant Garamond', serif;
    font-optical-sizing: auto;
    font-weight: normal;
    font-style: normal;
    font-size: 3rem;

    &:first-child {
      margin-top: 0;
    }

    &:not(:last-child) {
      margin-bottom: 1.5rem;
    }

    b {
      font-family: 'Quicksand', sans-serif;
      font-size: 0.875em;
    }
  }

  @media (max-width: 980px) {
    .c-global-title {
      font-size: clamp(1.75rem, 7vw, 3rem);
    }
  }

  /* Global link */
  .c-global-link {
    position: relative;
    display: inline-block;
    margin-left: 1.5em;
    color: #333;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-bottom: 2px dotted var(--c-orange);
    text-decoration: none;
  }

  .c-global-link::before {
    content: '';
    position: absolute;
    top: 0.25em;
    right: calc(100% + 0.5em);
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    background-color: var(--c-orange);
  }

  @media (max-width: 980px) {
    .c-global-link {
      font-size: 0.875rem;
    }
  }

  /* Global text container */
  .c-global-text-container {
    line-height: 1.7;
    white-space: pre-line;

    & > :last-child {
      margin-bottom: 0;
    }

    & > :first-child {
      margin-top: 0;
    }

    h2 {
      font-family: 'Cormorant Garamond', serif;
      font-optical-sizing: auto;
      font-weight: normal;
      font-style: normal;
      font-size: clamp(1.5rem, 6vw, 2.25rem);
      line-height: 1.4;
      margin-block: 1.25em 0.5em;
      color: var(--c-orange);
    }

    a {
      font-weight: 600;
      color: var(--c-orange);
      text-decoration: none;
      border-bottom: 2px dotted currentColor;

      &:hover {
        filter: brightness(60%);
      }
    }
  }
</style>
