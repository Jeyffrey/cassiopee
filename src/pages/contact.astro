---
import Layout from '../layouts/Layout.astro';
import { contentfulClient } from '../lib/contentful';
import type { Document } from '@contentful/rich-text-types';
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

const entries = await contentfulClient.getEntries({
  content_type: 'contact',
});

// Présentation
const texte = (await entries.items[0].fields?.texte) as Document;
const texteContent = texte ? documentToHtmlString(texte) : '';
---

<Layout
  title="Contact du chœur Cassiopée, Lyon - Chorale de jeunes"
  description="Contactez le Chœur Cassiopée, chorale de jeunes à Lyon. Une question, une envie de nous rejoindre ou de nous inviter ? Écrivez-nous."
  pageClass="contact-page"
>
  <section class="c-global-container">
    <h1 class="c-global-title">Contact</h1>
    <div class="c-global-text-container">
      <Fragment set:html={texteContent} />
    </div>
  </section>
</Layout>

<style is:global>
  .contact-page {
    main {
      flex: 0;
    }
  }
</style>
